FROM eclipse-temurin:25-jdk-jammy@sha256:d6ac622efdaafbf92f92f526910c2ea2e8312a47c3af981475eb21579513fae1 AS builder
WORKDIR /workspace
COPY mvnw mvnw
COPY .mvn .mvn
COPY pom.xml pom.xml
COPY config config
COPY build-support/pom.xml build-support/pom.xml
COPY outbox-lib/pom.xml outbox-lib/pom.xml
COPY common-core/pom.xml common-core/pom.xml
COPY common-web-starter/pom.xml common-web-starter/pom.xml
COPY common-lib/pom.xml common-lib/pom.xml
COPY security-lib/pom.xml security-lib/pom.xml
COPY proto/pom.xml proto/pom.xml
COPY events/pom.xml events/pom.xml
COPY test-support/pom.xml test-support/pom.xml
COPY api-gateway/pom.xml api-gateway/pom.xml
COPY product-service/pom.xml product-service/pom.xml
COPY cart-service/pom.xml cart-service/pom.xml
COPY order-service/pom.xml order-service/pom.xml
COPY inventory-service/pom.xml inventory-service/pom.xml
COPY payment-service/pom.xml payment-service/pom.xml
COPY notification-service/pom.xml notification-service/pom.xml
COPY e2e-tests/pom.xml e2e-tests/pom.xml
RUN chmod +x mvnw
COPY build-support/src build-support/src
COPY outbox-lib/src outbox-lib/src
COPY common-core/src common-core/src
COPY common-web-starter/src common-web-starter/src
COPY security-lib/src security-lib/src
COPY proto/src proto/src
COPY events/src events/src
COPY test-support/src test-support/src
COPY api-gateway/src api-gateway/src
COPY product-service/src product-service/src
COPY cart-service/src cart-service/src
COPY order-service/src order-service/src
COPY inventory-service/src inventory-service/src
COPY payment-service/src payment-service/src
COPY notification-service/src notification-service/src
COPY e2e-tests/src e2e-tests/src
RUN --mount=type=cache,target=/root/.m2 ./mvnw -B -ntp package -DskipTests -DskipITs -DskipE2ETests

FROM eclipse-temurin:25-jre-jammy@sha256:7ea228ef5a43661c3ea8ed08e2819d8bc844d0868b255040c61db3006ca67dcd AS runtime-base
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -r -g 1001 robomart && useradd -r -u 1001 -g robomart robomart \
    && chown robomart:robomart /app
USER robomart

FROM runtime-base AS api-gateway-extracted
COPY --from=builder /workspace/api-gateway/target/api-gateway-0.0.1-SNAPSHOT.jar /tmp/application.jar
RUN java -Djarmode=tools -jar /tmp/application.jar extract --layers --application-filename application.jar --destination /tmp/extracted

FROM runtime-base AS api-gateway
COPY --from=api-gateway-extracted --chown=1001:1001 /tmp/extracted/dependencies/ ./
COPY --from=api-gateway-extracted --chown=1001:1001 /tmp/extracted/spring-boot-loader/ ./
COPY --from=api-gateway-extracted --chown=1001:1001 /tmp/extracted/snapshot-dependencies/ ./
COPY --from=api-gateway-extracted --chown=1001:1001 /tmp/extracted/application/ ./
# Isolated core-context training: no application scan, auto-config, migrations or external I/O.
RUN --network=none java -XX:+UseCompactObjectHeaders -XX:MaxRAMPercentage=75 -XX:AOTCacheOutput=application.aot \
    -Dspring.context.exit=onRefresh -Dspring.config.location=optional:classpath:/aot-training-only/ \
    -cp application.jar com.robomart.build.AotCacheTraining
EXPOSE 8080 8090
HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD curl --fail --silent http://localhost:8090/actuator/health/liveness || exit 1
ENTRYPOINT ["java", "-XX:+UseCompactObjectHeaders", "-XX:MaxRAMPercentage=75", "-XX:AOTCache=application.aot", "-jar", "application.jar"]

