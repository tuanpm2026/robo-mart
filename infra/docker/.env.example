# Robo-Mart Docker Compose Environment
# Ports
POSTGRES_PORT=5432
ELASTICSEARCH_PORT=9200
KAFKA_PORT=29092
SCHEMA_REGISTRY_PORT=8085
KAFKA_UI_PORT=9090
REDIS_PORT=6379

KEYCLOAK_PORT=8180
KEYCLOAK_DB_PORT=5433

# Credentials (local development only)
POSTGRES_USER=robomart
POSTGRES_PASSWORD=robomart
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin

# Set the same generated secret in Keycloak and Inventory before enabling expiry reconciliation.
INVENTORY_SERVICE_CLIENT_SECRET=REPLACE_ME

# Must match the notification-service confidential client secret in Keycloak.
NOTIFICATION_SERVICE_CLIENT_SECRET=REPLACE_ME

# Canonical browser-facing Keycloak URL, also used for the resource-server issuer.
KEYCLOAK_PUBLIC_URL=http://localhost:8180

# Keep classic until all brokers are upgraded and group.version=1 is verified.
# E2E has its own label-guarded consumer-feature preparation.
KAFKA_GROUP_PROTOCOL=classic
